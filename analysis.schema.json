{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ivxlabs/difflicit/main/analysis.schema.json",
  "title": "Difflicit analysis",
  "description": "analysis.json at the root of a repository or folder makes it a Difflicit analysis of one project. The write-up goes in README.md, the patches in *.diff / *.patch files.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "project": {
      "description": "The id of the project this analyzes, as the Difflicit instance names it, e.g. CVE-2024-54494 on xnu.ivx.run.",
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "description": "The things this project compares (diffed any two at a time). Omit for stored *.diff / *.patch files.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "repo",
              "ref"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "const": "git"
              },
              "repo": {
                "type": "string",
                "description": "Path to a git repo inside the project (e.g. artifacts/xnu)."
              },
              "ref": {
                "type": "string",
                "description": "A commit, tag or branch."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "id",
              "type",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "file",
                  "files"
                ]
              },
              "path": {
                "type": "string",
                "description": "Path to a file (file) or directory (files)."
              }
            }
          }
        ]
      }
    },
    "base": {
      "type": "string",
      "description": "The default base (older) artifact id."
    },
    "head": {
      "type": "string",
      "description": "The default head (newer) artifact id."
    }
  },
  "required": [
    "project"
  ]
}
